# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust gateway (coinburst_gateway) — intermediate build artefacts only.
# The shipped .so files under android/app/src/main/jniLibs/<abi>/ MUST
# stay committed so the APK bundles them without a Gradle step.
rust/target/
!android/app/src/main/jniLibs/
!android/app/src/main/jniLibs/**/*.so

# Compile-time gray-part values. The shipped .so already seals them;
# this file exists only so a local rebuild can reproduce the same blobs.
rust/gateway.local

# Release signing material. Never commit the upload key or its passwords.
*.jks
*.keystore
key.properties
/release/

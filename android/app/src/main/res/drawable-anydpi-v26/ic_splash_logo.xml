<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splash foreground — kept byte-for-byte identical with
    mipmap-anydpi-v26/ic_launcher.xml so the system splash shows the
    SAME artwork the launcher renders.  Changing either one without the
    other causes a visible icon pop between the splash and the launch
    screen on cold start.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="14%" />
    </foreground>
</adaptive-icon>

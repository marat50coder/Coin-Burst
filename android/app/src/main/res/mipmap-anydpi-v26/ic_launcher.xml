<?xml version="1.0" encoding="utf-8"?>
<!-- Keep this in sync with drawable-anydpi-v26/ic_splash_logo.xml: the
     Android 12+ splash reuses the same adaptive icon so the launcher and the
     splash render identically. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="17%" />
    </foreground>
</adaptive-icon>

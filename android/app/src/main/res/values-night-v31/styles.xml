<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-mode variant of the Android 12+ splash. Keeps the same
    adaptive-icon and launch_bg so the splash reads identically in
    both themes — brand colours do not react to the system dark
    mode here.
-->
<resources>
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
